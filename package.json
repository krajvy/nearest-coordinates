{
  "name": "nearest-coordinates",
  "version": "3.0.0",
  "description": "Find nearest given GPS coordinates on Earth from start point.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krajvy/nearest-coordinates.git"
  },
  "keywords": [
    "nearest",
    "GPS",
    "coordinates"
  ],
  "author": "Jan Krivohlavek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/krajvy/nearest-coordinates/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "scripts": {
    "dev": "export VITE_APP_VERSION=DEV-$(git rev-parse --short HEAD) && vite",
    "build": "export VITE_APP_VERSION=$(git rev-parse --short HEAD) && tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest --config ./vitest.config.ts --run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "styled-components": "^6.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-leaflet": "^2.8.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^5.1.1"
  }
}
